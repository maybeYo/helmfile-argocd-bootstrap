# Plaintext TEMPLATE. Copy to argocd.yaml, fill in, encrypt, commit the encrypted file:
#   cp argocd.yaml.example argocd.yaml && $EDITOR argocd.yaml
#   sops -e -i argocd.yaml
# Merged into the argo-cd chart values by helmfile when secrets.enabled=true.
configs:
  secret:
    extra:
      # argocd account bcrypt --password '<password>'
      accounts.platform-admin.password: "$2a$10$REPLACE_WITH_BCRYPT_HASH"
      accounts.apps-admin.password: "$2a$10$REPLACE_WITH_BCRYPT_HASH"
      accounts.apps-sync.password: "$2a$10$REPLACE_WITH_BCRYPT_HASH"
      accounts.apps-readonly.password: "$2a$10$REPLACE_WITH_BCRYPT_HASH"

  # Only needed when the GitOps repository is private.
  # https://argo-cd.readthedocs.io/en/stable/user-guide/private-repositories/
  # repositories:
  #   gitops:
  #     url: https://github.com/<you>/<repo>.git
  #     githubAppID: "123456"
  #     githubAppInstallationID: "654321"
  #     githubAppPrivateKey: |
  #       -----BEGIN RSA PRIVATE KEY-----
  #       ...
  #       -----END RSA PRIVATE KEY-----
