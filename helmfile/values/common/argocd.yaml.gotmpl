{{- /*
Rendered by helmfile; .Values comes from helmfile/environments/<env>.yaml.

repo-server gets helm-secrets + sops + age + vals via an init container so that
Argo CD Applications can list SOPS-encrypted files in valueFiles. The wrapper
(HELM_SECRETS_WRAPPER_ENABLED) decrypts transparently, no `secrets://` prefix needed.

secrets.backend:
  age  - mount Secret argocd/helm-secrets-age-key (key.txt) and set SOPS_AGE_KEY_FILE
  kms  - IRSA annotation on the repo-server ServiceAccount + AWS_REGION
*/ -}}
{{- $backend := .Values.secrets.backend | default "age" }}

configs:
  cm:
    helm.valuesFileSchemes: >-
      secrets+gpg-import, secrets+gpg-import-kubernetes,
      secrets+age-import, secrets+age-import-kubernetes,
      secrets, secrets+literal,
      https

    # Local accounts. Passwords go in the SOPS-encrypted secrets file
    # (configs.secret.extra.accounts.<name>.password). See docs/argocd-rbac.md.
    accounts.platform-admin: apiKey, login
    accounts.apps-admin: apiKey, login
    accounts.apps-sync: apiKey, login
    accounts.apps-readonly: apiKey, login

  rbac:
    # Empty default: a user sees nothing until explicitly granted a role.
    policy.default: ""
    policy.csv: |
      # Full access to everything (a break-glass account besides `admin`).
      g, platform-admin, role:admin

      # Roles scoped to AppProject `apps` (created by argocd-projects).
      p, role:apps-readonly, applications, get, apps/*, allow
      p, role:apps-readonly, logs, get, apps/*, allow
      p, role:apps-readonly, projects, get, apps, allow
      p, role:apps-readonly, repositories, get, *, allow

      p, role:apps-sync, applications, get, apps/*, allow
      p, role:apps-sync, applications, sync, apps/*, allow
      p, role:apps-sync, logs, get, apps/*, allow
      p, role:apps-sync, projects, get, apps, allow
      p, role:apps-sync, repositories, get, *, allow

      p, role:apps-admin, applications, *, apps/*, allow
      p, role:apps-admin, applicationsets, *, apps/*, allow
      p, role:apps-admin, logs, get, apps/*, allow
      p, role:apps-admin, exec, create, apps/*, allow
      p, role:apps-admin, projects, get, apps, allow
      p, role:apps-admin, repositories, get, *, allow

      g, apps-readonly, role:apps-readonly
      g, apps-sync, role:apps-sync
      g, apps-admin, role:apps-admin

  # Public OCI registries used by Application definitions. Argo CD needs an
  # explicit repository entry with enableOCI for OCI Helm charts.
  repositories:
    oci-ghcr-actions-runner-controller:
      url: ghcr.io/actions/actions-runner-controller-charts
      name: actions-runner-controller
      type: helm
      enableOCI: "true"
    oci-ecr-public-karpenter:
      url: public.ecr.aws/karpenter
      name: karpenter
      type: helm
      enableOCI: "true"

repoServer:
{{- if eq $backend "kms" }}
  serviceAccount:
    annotations:
      # IRSA role allowed kms:Decrypt on the SOPS key (docs/aws-eks.md).
      eks.amazonaws.com/role-arn: {{ .Values.aws.repoServerRoleArn | quote }}
{{- end }}

  env:
    - name: HELM_PLUGINS
      value: /gitops-tools/helm-plugins/
    - name: HELM_SECRETS_CURL_PATH
      value: /gitops-tools/curl
    - name: HELM_SECRETS_SOPS_PATH
      value: /gitops-tools/sops
    - name: HELM_SECRETS_VALS_PATH
      value: /gitops-tools/vals
    - name: HELM_SECRETS_AGE_PATH
      value: /gitops-tools/age
    - name: HELM_SECRETS_KUBECTL_PATH
      value: /gitops-tools/kubectl
    - name: HELM_SECRETS_BACKEND
      value: sops
    # https://github.com/jkroepke/helm-secrets/wiki/Security-in-shared-environments
    - name: HELM_SECRETS_VALUES_ALLOW_SYMLINKS
      value: "false"
    - name: HELM_SECRETS_VALUES_ALLOW_ABSOLUTE_PATH
      value: "true"
    - name: HELM_SECRETS_VALUES_ALLOW_PATH_TRAVERSAL
      value: "false"
    - name: HELM_SECRETS_WRAPPER_ENABLED
      value: "true"
    - name: HELM_SECRETS_DECRYPT_SECRETS_IN_TMP_DIR
      value: "true"
    - name: HELM_SECRETS_HELM_PATH
      value: /usr/local/bin/helm
{{- if eq $backend "age" }}
    - name: SOPS_AGE_KEY_FILE
      value: /helm-secrets-age/key.txt
{{- else if eq $backend "kms" }}
    - name: AWS_REGION
      value: {{ .Values.aws.region | quote }}
    - name: AWS_DEFAULT_REGION
      value: {{ .Values.aws.region | quote }}
{{- end }}

  volumes:
    - name: gitops-tools
      emptyDir: {}
{{- if eq $backend "age" }}
    # kubectl -n argocd create secret generic helm-secrets-age-key --from-file=key.txt=<age private key>
    # `optional` lets repo-server start before the key exists (nothing decrypts until it does).
    - name: helm-secrets-age-key
      secret:
        secretName: helm-secrets-age-key
        optional: true
{{- end }}

  volumeMounts:
    - mountPath: /gitops-tools
      name: gitops-tools
    # The helm-secrets wrapper shadows the real helm binary on PATH.
    - mountPath: /usr/local/sbin/helm
      subPath: helm
      name: gitops-tools
{{- if eq $backend "age" }}
    - mountPath: /helm-secrets-age
      name: helm-secrets-age-key
      readOnly: true
{{- end }}

  initContainers:
    - name: download-tools
      image: alpine:3.22
      imagePullPolicy: IfNotPresent
      command: [sh, -euc]
      env:
        - name: HELM_SECRETS_VERSION
          value: "4.7.7"
        - name: KUBECTL_VERSION
          value: "1.36.2"
        - name: VALS_VERSION
          value: "0.44.5"
        - name: SOPS_VERSION
          value: "3.13.2"
        - name: AGE_VERSION
          value: "1.3.1"
        - name: HELM_PLUGINS
          value: /gitops-tools/helm-plugins/
        - name: HELM_SECRETS_CURL_PATH
          value: /gitops-tools/curl
        - name: HELM_SECRETS_SOPS_PATH
          value: /gitops-tools/sops
        - name: HELM_SECRETS_VALS_PATH
          value: /gitops-tools/vals
        - name: HELM_SECRETS_AGE_PATH
          value: /gitops-tools/age
        - name: HELM_SECRETS_KUBECTL_PATH
          value: /gitops-tools/kubectl
      args:
        - |
          mkdir -p "${HELM_PLUGINS}"

          CURL_ARCH=$(uname -m | sed -e 's/x86_64/amd64/')
          GO_ARCH=$(uname -m | sed -e 's/x86_64/amd64/' -e 's/\(arm\)\(64\)\?.*/\1\2/' -e 's/aarch64$/arm64/')

          wget -qO "${HELM_SECRETS_CURL_PATH}" "https://github.com/moparisthebest/static-curl/releases/latest/download/curl-${CURL_ARCH}"
          wget -qO "${HELM_SECRETS_KUBECTL_PATH}" "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${GO_ARCH}/kubectl"
          wget -qO "${HELM_SECRETS_SOPS_PATH}" "https://github.com/getsops/sops/releases/download/v${SOPS_VERSION}/sops-v${SOPS_VERSION}.linux.${GO_ARCH}"
          wget -qO- "https://github.com/helmfile/vals/releases/download/v${VALS_VERSION}/vals_${VALS_VERSION}_linux_${GO_ARCH}.tar.gz" | tar zx -C "${HELM_SECRETS_VALS_PATH%/*}" vals
          wget -qO- "https://github.com/jkroepke/helm-secrets/releases/download/v${HELM_SECRETS_VERSION}/helm-secrets.tar.gz" | tar -C "${HELM_PLUGINS}" -xzf-
          wget -qO- "https://github.com/FiloSottile/age/releases/download/v${AGE_VERSION}/age-v${AGE_VERSION}-linux-${GO_ARCH}.tar.gz" | tar -xzf- --strip-components=1 -C "${HELM_SECRETS_AGE_PATH%/*}" age/age

          chmod +x \
            "${HELM_SECRETS_CURL_PATH}" \
            "${HELM_SECRETS_SOPS_PATH}" \
            "${HELM_SECRETS_KUBECTL_PATH}" \
            "${HELM_SECRETS_VALS_PATH}" \
            "${HELM_SECRETS_AGE_PATH}"

          cp "${HELM_PLUGINS}/helm-secrets/scripts/wrapper/helm.sh" /gitops-tools/helm
      volumeMounts:
        - mountPath: /gitops-tools
          name: gitops-tools
